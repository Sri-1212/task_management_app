# TaskVerse Environment Configuration

# Server Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# If MongoDB URL is provided, TaskVerse connects to MongoDB.
# If empty or connection fails, it seamlessly falls back to local in-memory/file storage!
MONGODB_URI=mongodb://127.0.0.1:27017/taskverse

# Secrets
JWT_ACCESS_SECRET=taskverse_access_secret_anti_gravity_2026_super_secure
JWT_REFRESH_SECRET=taskverse_refresh_secret_zero_gravity_2026_ultra_secure
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
